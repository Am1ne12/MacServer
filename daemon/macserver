#!/bin/zsh
# MacServer - keeps the Mac awake on AC power, normal sleep on battery.
# Installed at /usr/local/bin/macserver and run as root by launchd.

set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

LABEL="com.am1ne.macserver.daemon"
WATCHDOG_LABEL="com.am1ne.macserver.watchdog"
STATE_DIR="/Users/Shared/MacServer"
PAUSE_FLAG="$STATE_DIR/paused"
BATTERY_FLAG="$STATE_DIR/keep-awake-battery"
LOCK_FLAG="$STATE_DIR/lock-now"
LOWPOWER_FLAG="$STATE_DIR/lowpower-owned"
STATUS_FILE="$STATE_DIR/status"
LOG_FILE="/var/log/macserver.log"
BATTERY_FLOOR=20
BATTERY_LOWPOWER_THRESHOLD=40
LOOP_SECONDS=1
STATUS_HEARTBEAT=5
WATCHDOG_STALE_SECONDS=60

CURRENT_THERMAL=0
CURRENT_LOWPOWER=0

log() {
  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') [$$] $*" >> "$LOG_FILE" 2>/dev/null || true
}

rotate_log() {
  local size
  if [[ -f "$LOG_FILE" ]]; then
    size=$(stat -f%z "$LOG_FILE" 2>/dev/null || print 0)
    if (( size > 1048576 )); then
      mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || true
      : > "$LOG_FILE"
      chmod 644 "$LOG_FILE" 2>/dev/null || true
    fi
  fi
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  chown root:staff "$STATE_DIR" 2>/dev/null || true
  chmod 2775 "$STATE_DIR" 2>/dev/null || true
  touch "$LOG_FILE" 2>/dev/null || true
  chown root:wheel "$LOG_FILE" 2>/dev/null || true
  chmod 644 "$LOG_FILE" 2>/dev/null || true
}

power_source() {
  if pmset -g batt 2>/dev/null | head -1 | grep -q "AC Power"; then
    print "AC"
  else
    print "BATTERY"
  fi
}

battery_percent() {
  local p
  p=$(pmset -g batt 2>/dev/null | grep -oE '[0-9]+%' | head -1 | tr -d '%')
  print "${p:-100}"
}

lid_state() {
  if ioreg -r -k AppleClamshellState -d 4 2>/dev/null | grep -q '"AppleClamshellState" = Yes'; then
    print "closed"
  else
    print "open"
  fi
}

sleep_disabled_now() {
  local v
  v=$(pmset -g 2>/dev/null | awk '/SleepDisabled/ {print $2; exit}')
  print "${v:-0}"
}

low_power_now() {
  local v
  v=$(pmset -g custom 2>/dev/null | awk '
    /^Battery Power:/ { in_battery = 1; next }
    /^AC Power:/ { in_battery = 0 }
    in_battery && /lowpowermode/ { print $2; exit }
  ')
  print "${v:-0}"
}

set_low_power() {
  local want="$1"
  local now
  now=$(low_power_now)
  if [[ "$now" != "$want" ]]; then
    if pmset -b lowpowermode "$want" >> "$LOG_FILE" 2>&1; then
      log "lowpowermode $want applied (was: $now)"
    else
      log "ERROR: pmset -b lowpowermode $want failed"
      return 1
    fi
  fi
  return 0
}

acquire_low_power() {
  if [[ ! -e "$LOWPOWER_FLAG" ]]; then
    : > "$LOWPOWER_FLAG" 2>/dev/null || true
    chown root:wheel "$LOWPOWER_FLAG" 2>/dev/null || true
    chmod 644 "$LOWPOWER_FLAG" 2>/dev/null || true
    log "low power mode requested (battery <= ${BATTERY_LOWPOWER_THRESHOLD}%)"
  fi
  set_low_power 1
  CURRENT_LOWPOWER=1
}

release_low_power() {
  if [[ -e "$LOWPOWER_FLAG" ]]; then
    set_low_power 0
    rm -f "$LOWPOWER_FLAG" 2>/dev/null || true
    log "low power mode restored"
  fi
  CURRENT_LOWPOWER=0
}

thermal_critical() {
  local therm cpu sched
  therm=$(pmset -g therm 2>/dev/null)
  cpu=$(print -r -- "$therm" | awk '/CPU_Speed_Limit/ {print $NF; exit}')
  sched=$(print -r -- "$therm" | awk '/Scheduler_Limit/ {print $NF; exit}')

  if [[ "$cpu" == <-> ]] && (( cpu < 50 )); then
    return 0
  fi
  if [[ "$sched" == <-> ]] && (( sched < 50 )); then
    return 0
  fi
  return 1
}

set_sleep_disabled() {
  local want="$1"
  local now
  now=$(sleep_disabled_now)
  if [[ "$now" != "$want" ]]; then
    if pmset -a disablesleep "$want" >> "$LOG_FILE" 2>&1; then
      log "disablesleep $want applied (was: $now)"
      if [[ "$want" == "1" ]]; then
        # Keep a PreventSystemSleep assertion for a few seconds after plugging
        # in, while disablesleep takes over.
        /usr/bin/caffeinate -s -t 5 >/dev/null 2>&1 &
      fi
    else
      log "ERROR: pmset -a disablesleep $want failed"
      return 1
    fi
  fi
  return 0
}

write_status() {
  local power="$1" lid="$2" paused="$3" battery_mode="$4" percent="$5" sleep_disabled="$6"
  local tmp="$STATE_DIR/.status.$$"
  {
    print "power=$power"
    print "lid=$lid"
    print "paused=$paused"
    print "keep_awake_battery=$battery_mode"
    print "battery=$percent"
    print "sleep_disabled=$sleep_disabled"
    print "thermal=$CURRENT_THERMAL"
    print "low_power=$CURRENT_LOWPOWER"
    print "timestamp=$(date +%s)"
    print "pid=$$"
  } > "$tmp" 2>/dev/null || return 0
  chmod 644 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$STATUS_FILE" 2>/dev/null || true
}

cleanup() {
  trap - EXIT INT TERM HUP
  pmset -a disablesleep 0 >/dev/null 2>&1 || true
  release_low_power
  CURRENT_THERMAL=0
  CURRENT_LOWPOWER=0
  local p=0 b=0
  [[ -e "$PAUSE_FLAG" ]] && p=1
  [[ -e "$BATTERY_FLAG" ]] && b=1
  write_status "UNKNOWN" "unknown" "$p" "$b" "0" "0"
  log "stopped: normal sleep restored"
  exit 0
}

daemon() {
  ensure_state_dir
  rotate_log
  log "started (pid $$)"
  trap cleanup EXIT INT TERM HUP

  # Best effort: wake when the charger is connected. Unsupported on some
  # Apple Silicon Macs; continue even if it fails.
  if pmset -a acwake 1 >> "$LOG_FILE" 2>&1; then
    log "acwake 1 requested"
  else
    log "acwake unsupported or refused"
  fi

  if sysadminctl -screenLock status -password - 2>&1 | grep -q "immediate"; then
    log "screen lock: immediate"
  else
    log "WARNING: screen lock is not immediate"
  fi

  local power lid paused battery_mode percent want sleep_disabled now first thermal
  local last_power="" last_lid="" last_paused="" last_battery_mode="" last_sleep="" last_thermal="" last_write=0
  first=1

  while true; do
    power=$(power_source)
    lid=$(lid_state)

    if [[ -e "$LOCK_FLAG" ]]; then
      rm -f "$LOCK_FLAG" 2>/dev/null || true
      pmset displaysleepnow >/dev/null 2>&1 || true
      log "screen lock requested"
    fi

    if [[ -e "$PAUSE_FLAG" ]]; then paused=1; else paused=0; fi
    if [[ -e "$BATTERY_FLAG" ]]; then battery_mode=1; else battery_mode=0; fi
    percent=$(battery_percent)

    thermal=0
    if thermal_critical; then
      thermal=1
    fi
    CURRENT_THERMAL=$thermal

    want=0
    if (( thermal == 1 )); then
      want=0
    elif (( paused == 0 )); then
      if [[ "$power" == "AC" ]]; then
        want=1
      elif (( battery_mode == 1 )) && (( percent > BATTERY_FLOOR )); then
        want=1
      fi
    fi

    if (( thermal == 0 && paused == 0 && battery_mode == 1 )) && [[ "$power" == "BATTERY" ]] && (( percent > BATTERY_FLOOR && percent <= BATTERY_LOWPOWER_THRESHOLD )); then
      acquire_low_power
    else
      release_low_power
    fi

    set_sleep_disabled "$want" || true
    sleep_disabled=$(sleep_disabled_now)

    # On lid close, turn off the display so macOS locks the session
    # immediately (the service keeps running in the background).
    if [[ "$lid" == "closed" && "$last_lid" != "closed" ]]; then
      pmset displaysleepnow >/dev/null 2>&1 || true
      log "lid closed: display off and screen locked"
    fi

    # Thermal protection: re-enable sleep; sleep if the lid is closed.
    if (( thermal == 1 )); then
      log "thermal protection active; sleep re-enabled"
      if [[ "$lid" == "closed" ]]; then
        pmset sleepnow >/dev/null 2>&1 || true
      fi
    fi

    # If we just switched back to normal sleep on battery with the lid
    # closed, sleep now to avoid draining the battery.
    if [[ "$power" == "BATTERY" && "$lid" == "closed" && "$want" == "0" ]]; then
      pmset sleepnow >/dev/null 2>&1 || true
    fi

    now=$(date +%s)
    if (( first == 1 )) || [[ "$power" != "$last_power" || "$lid" != "$last_lid" || "$paused" != "$last_paused" || "$battery_mode" != "$last_battery_mode" || "$sleep_disabled" != "$last_sleep" || "$thermal" != "$last_thermal" ]] || (( now - last_write >= STATUS_HEARTBEAT )); then
      write_status "$power" "$lid" "$paused" "$battery_mode" "$percent" "$sleep_disabled"
      last_write=$now
      first=0
    fi

    if [[ "$power" != "$last_power" || "$lid" != "$last_lid" || "$paused" != "$last_paused" || "$battery_mode" != "$last_battery_mode" || "$thermal" != "$last_thermal" ]]; then
      log "state: power=$power lid=$lid paused=$paused battery_mode=$battery_mode battery=${percent}% sleep_disabled=$sleep_disabled thermal=$thermal low_power=$CURRENT_LOWPOWER"
      last_power=$power
      last_lid=$lid
      last_paused=$paused
      last_battery_mode=$battery_mode
      last_thermal=$thermal
    fi
    last_sleep=$sleep_disabled

    sleep "$LOOP_SECONDS"
  done
}

watchdog() {
  ensure_state_dir
  local power lid paused battery_mode percent sleep_disabled want thermal ts now age

  power=$(power_source)
  lid=$(lid_state)
  if [[ -e "$PAUSE_FLAG" ]]; then paused=1; else paused=0; fi
  if [[ -e "$BATTERY_FLAG" ]]; then battery_mode=1; else battery_mode=0; fi
  percent=$(battery_percent)

  thermal=0
  if thermal_critical; then thermal=1; fi

  if ! pgrep -f "/usr/local/bin/macserver daemon" >/dev/null 2>&1; then
    log "watchdog: main daemon is not running; restoring normal sleep"
    pmset -a disablesleep 0 >> "$LOG_FILE" 2>&1 || true
    release_low_power
    launchctl kickstart -k system/com.am1ne.macserver.daemon 2>/dev/null || true
    return 0
  fi

  ts=0
  if [[ -r "$STATUS_FILE" ]]; then
    ts=$(awk -F= '/^timestamp=/{print $2; exit}' "$STATUS_FILE" 2>/dev/null)
  fi
  now=$(date +%s)
  age=$(( now - ${ts:-0} ))
  if (( age > WATCHDOG_STALE_SECONDS )); then
    log "watchdog: daemon status is stale (${age}s); restoring normal sleep"
    pmset -a disablesleep 0 >> "$LOG_FILE" 2>&1 || true
    release_low_power
    launchctl kickstart -k system/com.am1ne.macserver.daemon 2>/dev/null || true
    return 0
  fi

  want=0
  if (( thermal == 0 && paused == 0 )); then
    if [[ "$power" == "AC" ]]; then
      want=1
    elif (( battery_mode == 1 )) && (( percent > BATTERY_FLOOR )); then
      want=1
    fi
  fi

  sleep_disabled=$(sleep_disabled_now)
  if [[ "$sleep_disabled" != "$want" ]]; then
    log "watchdog: correcting disablesleep $sleep_disabled -> $want"
    pmset -a disablesleep "$want" >> "$LOG_FILE" 2>&1 || true
  fi

  if [[ "$lid" == "closed" ]] && { (( thermal == 1 )) || [[ "$power" == "BATTERY" && "$want" == "0" ]]; }; then
    pmset sleepnow >/dev/null 2>&1 || true
  fi

  if (( thermal == 0 && paused == 0 && battery_mode == 1 )) && [[ "$power" == "BATTERY" ]] && (( percent > BATTERY_FLOOR && percent <= BATTERY_LOWPOWER_THRESHOLD )); then
    acquire_low_power
  else
    release_low_power
  fi

  return 0
}

status_cmd() {
  local power lid percent disabled paused battery_mode thermal lowpower
  power=$(power_source)
  lid=$(lid_state)
  percent=$(battery_percent)
  disabled=$(sleep_disabled_now)
  lowpower=$(low_power_now)
  if [[ -e "$PAUSE_FLAG" ]]; then paused=1; else paused=0; fi
  if [[ -e "$BATTERY_FLAG" ]]; then battery_mode=1; else battery_mode=0; fi
  thermal=0
  if thermal_critical; then thermal=1; fi

  print "MacServer"
  print "  Power source      : $power"
  print "  Battery           : ${percent}%"
  print "  Lid               : $lid"
  print "  Sleep disabled    : $disabled"
  print "  Paused            : $paused"
  print "  Battery mode      : $battery_mode (stop at ${BATTERY_FLOOR}%)"
  print "  Thermal protection: $thermal"
  print "  Low power mode    : $lowpower"

  if pgrep -f "/usr/local/bin/macserver daemon" >/dev/null 2>&1; then
    print "  Service           : active"
  else
    print "  Service           : stopped"
  fi

  if [[ -r "$STATUS_FILE" ]]; then
    print "  Last state        :"
    sed 's/^/    /' "$STATUS_FILE"
  fi
}

pause_cmd() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if : > "$PAUSE_FLAG" 2>/dev/null; then
    print "MacServer paused."
  else
    print "Could not write the pause flag." >&2
    exit 1
  fi
}

resume_cmd() {
  rm -f "$PAUSE_FLAG" 2>/dev/null || true
  print "MacServer resumed."
}

battery_cmd() {
  local mode="${1:-}"
  case "$mode" in
    on)
      mkdir -p "$STATE_DIR" 2>/dev/null || true
      if : > "$BATTERY_FLAG" 2>/dev/null; then
        print "Battery mode enabled (stop at ${BATTERY_FLOOR}%)."
        print "Warning: the Mac will get warm and drain the battery."
      else
        print "Could not write the battery flag." >&2
        exit 1
      fi
      ;;
    off)
      rm -f "$BATTERY_FLAG" 2>/dev/null || true
      print "Battery mode disabled."
      ;;
    *)
      print "Usage: macserver battery on|off" >&2
      exit 1
      ;;
  esac
}

compact_cmd() {
  local mode="${1:-}"
  case "$mode" in
    on)
      mkdir -p "$STATE_DIR" 2>/dev/null || true
      if : > "$STATE_DIR/compact" 2>/dev/null; then
        print "Compact menu bar icon enabled."
      else
        print "Could not write the compact flag." >&2
        exit 1
      fi
      ;;
    off)
      rm -f "$STATE_DIR/compact" 2>/dev/null || true
      print "Compact menu bar icon disabled."
      ;;
    *)
      print "Usage: macserver compact on|off" >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  daemon)
    daemon
    ;;
  watchdog)
    watchdog
    ;;
  status)
    status_cmd
    ;;
  pause)
    pause_cmd
    ;;
  resume)
    resume_cmd
    ;;
  battery)
    shift
    battery_cmd "${1:-}"
    ;;
  compact)
    shift
    compact_cmd "${1:-}"
    ;;
  uninstall)
    if [[ $EUID -ne 0 ]]; then
      print "Uninstall requires sudo." >&2
      exit 1
    fi
    exec /usr/local/libexec/macserver-uninstall
    ;;
  *)
    print "Usage: macserver {daemon|watchdog|status|pause|resume|battery on|off|compact on|off|uninstall}" >&2
    exit 1
    ;;
esac
